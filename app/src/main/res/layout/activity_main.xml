<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Header -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="മൊഴി"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/on_bg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitle"
                android:textSize="12sp"
                android:textColor="@color/secondary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/theme_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_theme"
            android:contentDescription="@string/theme"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp" />

        <ImageButton
            android:id="@+id/about_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ic_info"
            android:contentDescription="@string/about"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp" />
    </LinearLayout>

    <!-- Stage: search box starts centered, slides to top when typing -->
    <LinearLayout
        android:id="@+id/stage"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Search box -->
        <LinearLayout
            android:id="@+id/search_box"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:gravity="center_vertical"
            android:background="@drawable/search_bg"
            android:paddingLeft="16dp"
            android:paddingRight="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="12dp"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/search_hint"
                android:textColor="@color/on_bg"
                android:textColorHint="@color/secondary"
                android:textSize="16sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <Button
                android:id="@+id/clear_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textSize="14sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="10dp"
                android:background="@null"
                android:textColor="@color/secondary"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Content -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <!-- First-run loading -->
            <LinearLayout
                android:id="@+id/loading_view"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/preparing"
                    android:textSize="14sp"
                    android:textColor="@color/secondary" />
            </LinearLayout>

            <!-- Empty / no matches -->
            <TextView
                android:id="@+id/empty_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/empty_hint"
                android:textSize="15sp"
                android:textColor="@color/secondary"
                android:visibility="gone" />

            <!-- Suggestions -->
            <ListView
                android:id="@+id/suggestions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/outline"
                android:dividerHeight="1dp"
                android:visibility="gone"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

            <!-- Word detail -->
            <ScrollView
                android:id="@+id/detail_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:clipToPadding="false"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/word_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_bg" />

                    <LinearLayout
                        android:id="@+id/meanings_box"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp"
        android:textSize="12sp"
        android:textColor="@color/secondary" />

</LinearLayout>
